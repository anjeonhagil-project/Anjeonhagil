# 통합 Python worker가 경로와 모델을 함께 계산한다. 실제 키와 DB 연결 문자열은 이 예시 파일에 넣지 않는다.
# 기능: Backend server-only 환경변수 이름 예시
PORT=3000
SUPABASE_URL=
SUPABASE_SECRET_KEY=
KAKAO_REST_API_KEY=
# 필요 시 공개데이터 API key를 서버 환경변수로 추가

# Anjeonhagil local routing worker (서버 전용)
ROUTING_WORKER_URL=http://127.0.0.1:8100
ROUTING_WORKER_TOKEN=
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
